ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://school_assistant:school_assistant@localhost:5432/school_assistant
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=replace_with_a_generated_fernet_key
CORS_ORIGINS=["http://localhost:3000"]
TELEGRAM_MODE=long_polling
API_HOST=0.0.0.0
API_PORT=8000
HEARTBEAT_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# Docker Compose database settings
POSTGRES_DB=school_assistant
POSTGRES_USER=school_assistant
# Required. Generate a unique password before starting Compose.
POSTGRES_PASSWORD=

# Legacy connector settings retained while connectors move behind the shared core.
MOODLE_TOKEN=your_moodle_web_service_token
MOODLE_URL=https://moodle.yourcampus.ca
MOODLE_USER_ID=your_moodle_numeric_user_id

TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

ANTHROPIC_API_KEY=your_anthropic_api_key

NOTION_API_KEY=your_notion_integration_secret
NOTION_CLASSES_DB=your_classes_database_id
NOTION_ASSIGNMENTS_DB=your_assignments_database_id
NOTION_TOPICS_DB=your_topics_database_id
NOTION_STUDY_SESSIONS_DB=your_study_sessions_database_id
